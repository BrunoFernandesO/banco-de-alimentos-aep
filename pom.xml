<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.unicesumar.esoft</groupId>
    <artifactId>banco-de-alimentos</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Sistema de Gestao de Banco de Alimentos</name>
    <description>AEP 2026.2 - Engenharia de Software - UniCesumar (Java 17 + MySQL via JDBC)</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mysql-connector-j.version>9.7.0</mysql-connector-j.version>
    </properties>

    <dependencies>
        <!-- Driver JDBC oficial do MySQL. Escopo "runtime": o codigo depende apenas
             da API padrao java.sql; o driver so e necessario ao executar. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector-j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Executa a aplicacao de console: mvnw compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>br.unicesumar.bancoalimentos.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
